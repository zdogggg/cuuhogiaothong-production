{
  "rules": {
    ".read": false,
    ".write": false,

    "settings": { ".read": true },
    "pricing": { ".read": true },
    "news": { ".read": true },

    "trackings": {
      "$bookingId": {
        ".read": "$bookingId.matches(/^CH[A-Z0-9]{8}$/)",
        ".write": "$bookingId.matches(/^CH[A-Z0-9]{8}$/) && newData.exists()",
        ".validate": "newData.hasChildren(['status'])",
        "lat": { ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 90" },
        "lng": { ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180" },
        "timestamp": { ".validate": "newData.isNumber() && newData.val() <= now + 60000" },
        "status": { ".validate": "newData.isString() && newData.val().matches(/^(moving|arrived)$/)" },
        "$other": { ".validate": false }
      }
    }
  }
}
