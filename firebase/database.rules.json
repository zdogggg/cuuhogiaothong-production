{
  "rules": {
    ".read": false,
    ".write": false,

    "admins": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },

    "settings": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "logoUrl": { ".validate": "newData.isString() && (newData.val() === '' || newData.val().beginsWith('https://')) && newData.val().length < 1000" },
      "footerLogoUrl": { ".validate": "newData.isString() && (newData.val() === '' || newData.val().beginsWith('https://')) && newData.val().length < 1000" },
      "bannerUrl": { ".validate": "newData.isString() && (newData.val() === '' || newData.val().beginsWith('https://')) && newData.val().length < 1000" },
      "$other": { ".validate": false }
    },

    "pricing": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$itemId": {
        ".validate": "newData.hasChildren(['vehicle'])",
        "group": { ".validate": "newData.isString() && newData.val().length <= 100" },
        "vehicle": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 200" },
        "basePrice": { ".validate": "newData.isString() && newData.val().length <= 100" },
        "extraPrice": { ".validate": "newData.isString() && newData.val().length <= 100" },
        "description": { ".validate": "newData.isString() && newData.val().length <= 1000" },
        "order": { ".validate": "newData.isNumber()" },
        "$other": { ".validate": false }
      }
    },

    "trackings": {
      "$bookingId": {
        ".read": "$bookingId.matches(/^CH[A-Z0-9]{8}$/)",
        ".write": "$bookingId.matches(/^CH[A-Z0-9]{8}$/) && newData.exists()",
        ".validate": "newData.hasChildren(['status'])",
        "lat": { ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 90" },
        "lng": { ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180" },
        "timestamp": { ".validate": "newData.isNumber() && newData.val() <= now + 60000" },
        "status": { ".validate": "newData.isString() && newData.val().matches(/^(moving|arrived)$/)" },
        "$other": { ".validate": false }
      }
    }
  }
}
